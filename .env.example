# Google Analytics Setup
VITE_GA_ID=G-XXXXXXXXXX

# Replace G-XXXXXXXXXX with your actual Google Analytics 4 Measurement ID
# Get it from: https://analytics.google.com

# Telegram bot (used by npm run start:bot)
BOT_TOKEN=""
TELEGRAM_TEAM_CHAT_ID=""
TELEGRAM_ADMIN_IDS=""

# Database for bot + backend
DATABASE_URL="file:./backend/dev.db"

# Bot worker tuning
TELEGRAM_POLL_INTERVAL=3000
TELEGRAM_NOTIF_BATCH_SIZE=20
TELEGRAM_NOTIF_MAX_RETRIES=5
TELEGRAM_NOTIF_RETRY_BASE_MS=10000
TELEGRAM_NOTIF_RETRY_MAX_MS=900000
TELEGRAM_NOTIF_PROCESSING_TIMEOUT_MS=120000
TELEGRAM_SUPPORT_COOLDOWN_MS=30000
TELEGRAM_REMINDER_TIMEZONE="Europe/Kyiv"
TELEGRAM_REMINDER_HOUR=9
TELEGRAM_REMINDER_MINUTE=0
TELEGRAM_REMINDER_WINDOW_MINUTES=20

# Tax rules used by calculators
TAX_FOP3_SINGLE_TAX_RATE=0.05
TAX_FOP3_ESV_MONTHLY_UAH=1760
TAX_SALARY_PDFO_RATE=0.18
TAX_SALARY_VZ_RATE=0.05
TAX_SALARY_ESV_RATE=0.22
